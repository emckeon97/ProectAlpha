<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:GifScroll.Windows.Views"
       x:Class="GifScroll.Windows.AppShell"
       Shell.NavBarIsVisible="False"
       Shell.TabBarBackgroundColor="Black"
       Shell.TabBarForegroundColor="White"
       Shell.TabBarUnselectedColor="Gray">

    <TabBar>
        <ShellContent Title="Feed" Icon="🏠"
                      ContentTemplate="{DataTemplate views:FeedPage}" />
        <ShellContent Title="Uploads" Icon="📤"
                      ContentTemplate="{DataTemplate views:UploadsPage}" />
        <ShellContent Title="Account" Icon="👤"
                      ContentTemplate="{DataTemplate views:AccountPage}" />
    </TabBar>

</Shell>

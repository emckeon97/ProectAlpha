<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GifScroll.Windows.Views.FeedPage"
             BackgroundColor="Black">

    <Grid>
        <CarouselView x:Name="FeedCarousel"
                      ItemsSource="{Binding Items}"
                      Loop="False">
            <CarouselView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"
                                   ItemSpacing="0"
                                   SnapPointsType="MandatorySingle"
                                   SnapPointsAlignment="Start" />
            </CarouselView.ItemsLayout>
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="*,Auto">
                        <!-- Media -->
                        <Grid Grid.Row="0">
                            <Image Source="{Binding Url}"
                                   Aspect="AspectFit"
                                   IsVisible="{Binding IsNotVideo}" />
                            <toolkit:MediaElement Source="{Binding Url}"
                                                  Aspect="AspectFit"
                                                  ShouldAutoPlay="True"
                                                  ShouldShowPlaybackControls="False"
                                                  ShouldLoopPlayback="True"
                                                  IsVisible="{Binding IsVideo}" />
                        </Grid>

                        <!-- Caption + actions -->
                        <Grid Grid.Row="1" Padding="16,8,16,24"
                              ColumnDefinitions="*,Auto"
                              BackgroundColor="#80000000">
                            <Label Grid.Column="0" Text="{Binding Title}"
                                   TextColor="White" FontSize="14"
                                   MaxLines="3" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="12"
                                                   VerticalOptions="Center">
                                <Button Text="😂" FontSize="22"
                                        BackgroundColor="#8C000000"
                                        CornerRadius="24" WidthRequest="48" HeightRequest="48"
                                        Clicked="OnLikeClicked"
                                        CommandParameter="{Binding .}" />
                                <Button Text="💬" FontSize="22"
                                        BackgroundColor="#8C000000"
                                        CornerRadius="24" WidthRequest="48" HeightRequest="48"
                                        Clicked="OnCommentsClicked"
                                        CommandParameter="{Binding .}" />
                                <Button Text="🚩" FontSize="22"
                                        BackgroundColor="#8C000000"
                                        CornerRadius="24" WidthRequest="48" HeightRequest="48"
                                        Clicked="OnReportClicked"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <Label Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               TextColor="White" HorizontalTextAlignment="Center"
               VerticalOptions="Center" HorizontalOptions="Center"
               Margin="32" />
    </Grid>

</ContentPage>

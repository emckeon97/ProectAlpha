<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GifScroll.Windows.Views.UploadsPage"
             BackgroundColor="Black"
             Title="Uploads">
    <Grid RowDefinitions="Auto,*">
        <Label Grid.Row="0" Text="Community uploads"
               TextColor="White" FontSize="20" FontAttributes="Bold"
               Margin="16,16,16,8" />
        <CollectionView x:Name="PostsList" Grid.Row="1"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid RowDefinitions="Auto,Auto" Padding="16,8">
                        <Image Grid.Row="0" Source="{Binding MediaUrl}"
                               Aspect="AspectFit" MaximumHeightRequest="400" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto"
                              Padding="0,8,0,0">
                            <Label Grid.Column="0" Text="{Binding Title}"
                                   TextColor="White" FontSize="14" />
                            <Button Grid.Column="1" Text="💬" FontSize="18"
                                    BackgroundColor="#8C000000" CornerRadius="20"
                                    WidthRequest="40" HeightRequest="40"
                                    Clicked="OnCommentsClicked"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No uploads yet."
                       TextColor="Gray" HorizontalTextAlignment="Center"
                       Margin="0,32,0,0" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>

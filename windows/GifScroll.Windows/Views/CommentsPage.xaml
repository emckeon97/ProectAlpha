<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GifScroll.Windows.Views.CommentsPage"
             BackgroundColor="#111111"
             Title="Comments">
    <Grid RowDefinitions="Auto,*,Auto" Padding="16">
        <Label x:Name="TitleLabel" Grid.Row="0"
               TextColor="White" FontSize="14" MaxLines="2"
               Margin="0,0,0,12" />

        <CollectionView x:Name="CommentsList" Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#1E1E1E" CornerRadius="8"
                           Padding="12,8" Margin="0,0,0,8" HasShadow="False">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Author}" FontSize="12"
                                   FontAttributes="Bold" TextColor="#FFD54F" />
                            <Label Text="{Binding Body}" FontSize="14"
                                   TextColor="White" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="No comments yet — be the first!"
                       TextColor="Gray" HorizontalTextAlignment="Center"
                       Margin="0,32,0,0" />
            </CollectionView.EmptyView>
        </CollectionView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8"
              Margin="0,12,0,0">
            <Entry x:Name="CommentEntry" Grid.Column="0"
                   Placeholder="Add a comment… (anonymous OK)"
                   PlaceholderColor="Gray" TextColor="White"
                   BackgroundColor="#1E1E1E" />
            <Button Grid.Column="1" Text="Send" Clicked="OnSendClicked"
                    BackgroundColor="#FFD54F" TextColor="Black"
                    CornerRadius="8" />
        </Grid>
    </Grid>
</ContentPage>

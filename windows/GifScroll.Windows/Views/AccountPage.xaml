<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GifScroll.Windows.Views.AccountPage"
             BackgroundColor="#111111"
             Title="Account">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12"
                             VerticalOptions="Center"
                             MaximumWidthRequest="420"
                             HorizontalOptions="Center">

            <Label x:Name="StatusLabel" Text="You're browsing anonymously."
                   TextColor="White" FontSize="16"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="LikesLabel" TextColor="#FFD54F" FontSize="14"
                   HorizontalTextAlignment="Center" />

            <Entry x:Name="EmailEntry" Placeholder="Email"
                   Keyboard="Email" TextColor="White"
                   BackgroundColor="#1E1E1E" IsVisible="False" />
            <Entry x:Name="PasswordEntry" Placeholder="Password"
                   IsPassword="True" TextColor="White"
                   BackgroundColor="#1E1E1E" IsVisible="False" />
            <Entry x:Name="NameEntry" Placeholder="Display name"
                   TextColor="White" BackgroundColor="#1E1E1E"
                   IsVisible="False" />

            <Button x:Name="PrimaryButton" Text="Sign in"
                    Clicked="OnPrimaryClicked"
                    BackgroundColor="#FFD54F" TextColor="Black"
                    CornerRadius="8" IsVisible="False" />
            <Button x:Name="ToggleButton" Text="Create account instead"
                    Clicked="OnToggleClicked"
                    BackgroundColor="Transparent" TextColor="#FFD54F"
                    IsVisible="False" />
            <Button x:Name="AuthToggleButton" Text="Sign in / Sign up"
                    Clicked="OnShowAuthClicked"
                    BackgroundColor="#333333" TextColor="White"
                    CornerRadius="8" />
            <Button x:Name="SignOutButton" Text="Sign out"
                    Clicked="OnSignOutClicked"
                    BackgroundColor="#333333" TextColor="White"
                    CornerRadius="8" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
